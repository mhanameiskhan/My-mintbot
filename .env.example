# Comma-separated list of RPC endpoints. Bot round-robins / fails over across them.
RPC_URLS=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY,https://mainnet.infura.io/v3/YOUR_INFURA_KEY,https://rpc.ankr.com/eth

# Comma-separated wallet addresses you want to track for mints
WATCHED_WALLETS=0xWalletToWatch1,0xWalletToWatch2

# Your wallet's private key (only needed if DRY_RUN=false). Keep this secret, never commit it.
PRIVATE_KEY=

# https://etherscan.io/myapikey — used to fetch verified ABIs so the bot can find the real mint function
ETHERSCAN_API_KEY=

# https://docs.opensea.io/reference/api-overview — used to look up collection info after a mint
OPENSEA_API_KEY=

# How often (ms) to poll for new mints
POLL_INTERVAL_MS=15000

# true = only log what would happen, never sends a transaction (recommended while testing)
DRY_RUN=true

# ETH value to attach to the mint call, if the contract's mint function is payable
MINT_VALUE_ETH=0

# Quantity argument for contracts whose mint function takes a quantity
MINT_ARG_QUANTITY=1
